HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
POSTGRES_URL=postgres://logstream:logstream@localhost:5432/logstream
POSTGRES_POOL_SIZE=8
PARTITION_LOOKAHEAD_DAYS=3
CURSOR_SECRET=replace-this-in-production
RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60
INGEST_FLUSH_MS=10
INGEST_BATCH_SIZE=5000
INGEST_QUEUE_LIMIT=200000
INGEST_SYNCHRONOUS_COMMIT=true
