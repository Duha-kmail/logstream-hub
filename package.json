{
  "name": "logstream-hub",
  "version": "0.1.0",
  "description": "A TypeScript service for receiving and exploring structured logs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/commands/migrate.ts",
    "start": "node build/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
